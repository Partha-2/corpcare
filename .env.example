# CorpCare Environment Variables
# Copy this file to .env and fill in your values

# Database (defaults to local Postgres via docker-compose)
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/corpcare
# SPRING_DATASOURCE_USERNAME=corpcare
# SPRING_DATASOURCE_PASSWORD=corpcare

# Admin
ADMIN_PASSWORD=admin123

# Groq AI Chat
GROQ_API_KEY=

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Bolna.ai Voice Calls
BOLNA_API_KEY=
